# Port the server listens on. Most hosts (Render, Fly.io, Railway) set this
# for you automatically — you usually don't need to touch it.
PORT=3001

# The origin of your deployed client (e.g. https://yourname.github.io), so
# the server only accepts connections from your game. Use * while testing
# locally; lock it down once you deploy for real.
CLIENT_ORIGIN=*
